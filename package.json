{
  "name": "crm-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Encaminha install/build para web/. Não coloque dependências da app aqui.",
  "scripts": {
    "postinstall": "npm --prefix web ci --no-audit --no-fund",
