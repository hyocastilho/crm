{
  "name": "crm-workspace",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix web ci --no-audit --no-fund",
    "dev": "npm --prefix web run dev -- --port 8080 --host 0.0.0.0",
    "build:dev": "npm --prefix web run build && mkdir -p dist && cp -r web/dist/. dist/",
    "build": "bun run build:dev"
  }
}
