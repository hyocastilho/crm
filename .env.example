# Copie este arquivo para .env na raiz do projeto.
# Docker Compose e o Django leem esse único arquivo.
# Não crie .env dentro de back/ nem de web/.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,back

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Portas no seu computador. 8000 e 5173 ficam livres para outros projetos.
BACK_PORT=8010
WEB_PORT=5175

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CSRF_TRUSTED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
