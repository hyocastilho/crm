# Copie este arquivo para .env na raiz do projeto.
# Docker Compose e o Django leem esse único arquivo.
# Não crie .env dentro de back/ nem de web/.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,back

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Portas no seu computador. 8000 e 5173 ficam livres para outros projetos.
BACK_PORT=8010
WEB_PORT=5175

# Demonstração. Com SEED_DEMO=false o container não cria essa loja nem esse login.
# Para apagar o que já foi criado: docker compose exec back python manage.py clear_demo
SEED_DEMO=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CSRF_TRUSTED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
